NODE_ENV=development
PORT=3000
DB_URI=mongodb://127.0.0.1:27017/sara7a
# Exactly 32 UTF-8 bytes. Generate your own value.
ENCRYPTION_SECRET=
# Four independent random signing secrets, at least 32 characters for production.
TOKEN_USER_ACCESS_KEY=
TOKEN_USER_REFRESH_KEY=
TOKEN_ADMIN_ACCESS_KEY=
TOKEN_ADMIN_REFRESH_KEY=
ABUSE_HASH_SECRET=
ACCESS_EXPIRE=900
REFRESH_EXPIRE=604800
USER_EMAIL=
# Gmail app password, not your normal account password.
USER_PASSWORD=
CLIENT_ID=
PUBLIC_URL=http://localhost:3000
WHITE_LIST=http://localhost:5173
# Comma-separated trusted proxy IPs/CIDRs, or empty for direct connections.
TRUST_PROXY=
# Optional Cloudflare Turnstile secret; enables mandatory CAPTCHA for message sending.
CAPTCHA_SECRET=
